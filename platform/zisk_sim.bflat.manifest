{
  "$schema": "https://raw.githubusercontent.com/NethermindEth/bflat-riscv64/master/src/bflat/bflat-manifest.schema.json",
  "schema": 2,
  "name": "zisk_sim",
  "version": "1.0.0",
  "description": "The ZisK simulator platform: the ZisK entry point with a debugging memory map",
  "note": "No no-console flag: the simulator keeps the host console and host stdio. It links no libziskos.",
  "codegen": {
    "abi": "lp64",
    "isa": {"disable": ["c", "a", "f", "d", "zba", "zbb", "zbs", "zicond"]},
    "options": [
      {
        "value": "RiscV64ElideLeafRaSave=1",
        "when": {"optimize": true},
        "note": "Elide the RA spill/reload and frame in leaf methods (dotnet-riscv patches 23 and 31). Sound only on a single-threaded deterministic guest with no GC thread suspension and no return-address hijacking."
      },
      {
        "value": "EnableRiscV64Compressed=0",
        "note": "The decoder has no C extension, and a single-threaded guest needs no atomics: the managed .text stays 32-bit and lock-free (dotnet-riscv fixups 24/25). Check with --error-on-compressed / --error-on-atomic."
      },
      "EnableRiscV64Atomic=0",
      {
        "value": "JitZkBumpAddr=bffbfff8",
        "note": "Per-site inline allocation (dotnet-riscv fixup 26): the cell of the bump pointer, at a fixed address. It MUST equal g_zk_bump_ptr in the linker script. The same cell as ZisK: the simulator copies the ZisK memory map."
      }
    ]
  },
  "platform": {
    "aliases": {"libc": "zisk_sim"},
    "base": {"os": "linux", "arch": "riscv64", "libc": "musl"},
    "requires": [
      "nofp",
      "ubootstrap",
      "stdcppshim",
      "rhp",
      "gs_cookie",
      "rhp_native",
      "pal",
      "eh",
      "tls",
      "rng_stupid",
      "rust_sys",
      "ugc-zero",
      "nothread",
      "noos",
      "guest_subst"
    ],
    "linker_script": "zisk_sim.ld",
    "entry": "zisk_entry.o"
  }
}
